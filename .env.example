# Copy this file to .env and fill in values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

FNMUSIC_HOME=

# Sources: enable at least one (install.sh --sources musicdl,musicbox,lxmusic)
# musicdl: https://github.com/CharlesPikachu/musicdl
# musicbox: https://github.com/darknessomi/musicbox
# lxmusic: 洛雪音乐源（免登录解析：酷狗 kg / 网易 wy / 咪咕 mg，高音质直链）
FNMUSIC_MUSICDL_ENABLED=true
FNMUSIC_NETEASE_ENABLED=true
FNMUSIC_MUSICDL_URL=http://127.0.0.1:8768
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
FNMUSIC_ONLINE_SOURCES=MiguMusicClient,KuwoMusicClient

# 洛雪音乐源 lxmusic（第三音源，宿主机端口 8772 -> 容器 8000）
FNMUSIC_LX_ENABLED=true
FNMUSIC_LX_URL=http://127.0.0.1:8772
# tx 暂无播放解析链路，默认不启用；有限媒体探活不保证完整歌曲。
LX_SOURCES=kg,wy,mg,kw
LX_THIRD_PARTY=1
LX_SEARCH_TIMEOUT=12
LX_LIMIT_PER_SOURCE=20
FNMUSIC_DEPLOY_MODE=docker

# Daily recommend (OpenAI-compatible). Leave empty to disable.
FNMUSIC_LLM_BASE_URL=
FNMUSIC_LLM_API_KEY=
FNMUSIC_LLM_MODEL=gpt-4o-mini

# Docker 构建源（docker 模式；v1.2.3+）
# 基础镜像：留空时安装自动探测（国内镜像优先直连绕开 daemon 加速器，官方源兜底）并缓存到此键；
# 也可手动指定可用镜像引用，例如 docker.m.daocloud.io/library/python:3.13-slim
FNMUSIC_BASE_IMAGE=
# Node 基础镜像（lxsource 订阅音源服务用）：同样留空自动探测并缓存；
# 也可手动指定，例如 docker.m.daocloud.io/library/node:22-alpine
FNMUSIC_NODE_IMAGE=
# 容器内 pip 源（默认清华，与宿主机模式一致）
FNMUSIC_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# musicdl 镜像内 apt 源（默认清华；仅构建层内临时替换+失败自动回退官方源，不影响宿主机与最终镜像；
# 想强制官方源可设为 http://deb.debian.org）
FNMUSIC_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# 可选：自动探测时的国内镜像候选列表（空格分隔，按序尝试）
FNMUSIC_DOCKER_MIRRORS=docker.1ms.run docker.m.daocloud.io docker.1panel.live hub.rat.dev

# ---- 洛雪歌单：把平台排行榜注入飞牛音乐侧边栏（v1.4.0+，默认关闭）----
# 开启后在侧边栏「歌单」中出现网易云/酷狗/酷我的排行榜，点击即可播放。
# 曲目播放仍由 lxmusic-service 解析直链（见 FNMUSIC_LX_* 配置）。
FNMUSIC_CHARTS_ENABLED=false
# 侧边栏加载时等待榜单接口的上限（秒）；超时则本次不注入，避免拖慢侧边栏
FNMUSIC_CHART_LIST_WAIT=6
# 展示哪些平台（逗号分隔）
FNMUSIC_CHART_PLATFORMS=wy,kg,kw
# 榜单缓存有效期（秒）与单榜最多曲目数
FNMUSIC_CHART_TTL=1800
FNMUSIC_CHART_TRACK_LIMIT=100
# 平台接口偶发抖动时的重试次数
FNMUSIC_CHART_RETRIES=3
# 榜单封面尺寸（酷狗封面 URL 含 {size} 占位符，默认替换为 480）
FNMUSIC_CHART_COVER_SIZE=480
# 榜单曲目默认扩展名：有损源才回退 mp3（仅影响界面显示与落盘文件名）
FNMUSIC_CHART_DEFAULT_EXT=flac
